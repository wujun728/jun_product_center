<mapper namespace="com.ruoyi.qixing.mapper.PjProjectDailyMapper">
    
    <resultMap type="PjProjectDaily" id="PjProjectDailyResult">
        <result property="id"    column="id"    />
        <result property="planName"    column="plan_name"    />
        <result property="refProjectCode"    column="ref_project_code"    />
        <result property="refProjectName"    column="ref_project_name"    />
        <result property="dictDailyType"    column="dict_daily_type"    />
        <result property="dailyDate"    column="daily_date"    />
        <result property="dailyDetail"    column="daily_detail"    />
        <result property="costTime"    column="cost_time"    />
        <result property="dictRisk"    column="dict_risk"    />
