            <if test="costTime != null">#{costTime},</if>
            <if test="dictRisk != null">#{dictRisk},</if>
            <if test="dictAskHelp != null">#{dictAskHelp},</if>
            <if test="dictIsDelay != null">#{dictIsDelay},</if>
            <if test="remark != null">#{remark},</if>
            <if test="creator != null">#{creator},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createId != null">#{createId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateId != null">#{updateId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderStatus != null">#{orderStatus},</if>
         </trim>
    </insert>

    <update id="updatePjProjectDaily" parameterType="PjProjectDaily">
        update pj_project_daily
        <trim prefix="SET" suffixOverrides=",">
            <if test="planName != null and planName != ''">plan_name = #{planName},</if>
            <if test="refProjectCode != null">ref_project_code = #{refProjectCode},</if>
            <if test="refProjectName != null and refProjectName != ''">ref_project_name = #{refProjectName},</if>
            <if test="dictDailyType != null">dict_daily_type = #{dictDailyType},</if>
            <if test="dailyDate != null">daily_date = #{dailyDate},</if>
