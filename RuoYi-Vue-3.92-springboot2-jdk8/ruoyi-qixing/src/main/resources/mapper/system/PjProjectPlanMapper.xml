<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.qixing.mapper.PjProjectPlanMapper">
    
    <resultMap type="PjProjectPlan" id="PjProjectPlanResult">
        <result property="id"    column="id"    />
        <result property="refProjectCode"    column="ref_project_code"    />
        <result property="refProjectName"    column="ref_project_name"    />
        <result property="planName"    column="plan_name"    />
        <result property="planDetail"    column="plan_detail"    />
        <result property="planTimeStart"    column="plan_time_start"    />
        <result property="planTimeEnd"    column="plan_time_end"    />
        <result property="planDates"    column="plan_dates"    />
        <result property="planGivenTime"    column="plan_given_time"    />
        <result property="planFinashDays"    column="plan_finash_days"    />
        <result property="planFinashDays2"    column="plan_finash_days2"    />
        <result property="remark"    column="remark"    />
        <result property="creator"    column="creator"    />
        <result property="createTime"    column="create_time"    />
        <result property="createId"    column="create_id"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateId"    column="update_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderStatus"    column="order_status"    />
    </resultMap>

    <sql id="selectPjProjectPlanVo">
        select id, ref_project_code, ref_project_name, plan_name, plan_detail, plan_time_start, plan_time_end, plan_dates, plan_given_time, plan_finash_days, plan_finash_days2, remark, creator, create_time, create_id, update_time, update_id, order_id, order_status from pj_project_plan
    </sql>

    <select id="selectPjProjectPlanList" parameterType="PjProjectPlan" resultMap="PjProjectPlanResult">
        <include refid="selectPjProjectPlanVo"/>
        <where>  
            <if test="refProjectCode != null  and refProjectCode != ''"> and ref_project_code = #{refProjectCode}</if>
            <if test="refProjectName != null  and refProjectName != ''"> and ref_project_name like concat('%', #{refProjectName}, '%')</if>
            <if test="planName != null  and planName != ''"> and plan_name like concat('%', #{planName}, '%')</if>
            <if test="planDetail != null  and planDetail != ''"> and plan_detail = #{planDetail}</if>
            <if test="planTimeStart != null "> and plan_time_start = #{planTimeStart}</if>
            <if test="planTimeEnd != null "> and plan_time_end = #{planTimeEnd}</if>
            <if test="planDates != null  and planDates != ''"> and plan_dates = #{planDates}</if>
            <if test="planGivenTime != null "> and plan_given_time = #{planGivenTime}</if>
            <if test="planFinashDays != null "> and plan_finash_days = #{planFinashDays}</if>
            <if test="planFinashDays2 != null "> and plan_finash_days2 = #{planFinashDays2}</if>
            <if test="creator != null  and creator != ''"> and creator = #{creator}</if>
            <if test="createId != null  and createId != ''"> and create_id = #{createId}</if>
            <if test="updateId != null  and updateId != ''"> and update_id = #{updateId}</if>
            <if test="orderId != null  and orderId != ''"> and order_id = #{orderId}</if>
            <if test="orderStatus != null "> and order_status = #{orderStatus}</if>
        </where>
    </select>
    
    <select id="selectPjProjectPlanById" parameterType="String" resultMap="PjProjectPlanResult">
        <include refid="selectPjProjectPlanVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertPjProjectPlan" parameterType="PjProjectPlan">
        insert into pj_project_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="refProjectCode != null">ref_project_code,</if>
            <if test="refProjectName != null and refProjectName != ''">ref_project_name,</if>
            <if test="planName != null and planName != ''">plan_name,</if>
            <if test="planDetail != null and planDetail != ''">plan_detail,</if>
            <if test="planTimeStart != null">plan_time_start,</if>
            <if test="planTimeEnd != null">plan_time_end,</if>
            <if test="planDates != null and planDates != ''">plan_dates,</if>
            <if test="planGivenTime != null">plan_given_time,</if>
            <if test="planFinashDays != null">plan_finash_days,</if>
            <if test="planFinashDays2 != null">plan_finash_days2,</if>
            <if test="remark != null">remark,</if>
            <if test="creator != null">creator,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createId != null">create_id,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateId != null">update_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderStatus != null">order_status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="refProjectCode != null">#{refProjectCode},</if>
            <if test="refProjectName != null and refProjectName != ''">#{refProjectName},</if>
            <if test="planName != null and planName != ''">#{planName},</if>
            <if test="planDetail != null and planDetail != ''">#{planDetail},</if>
            <if test="planTimeStart != null">#{planTimeStart},</if>
            <if test="planTimeEnd != null">#{planTimeEnd},</if>
            <if test="planDates != null and planDates != ''">#{planDates},</if>
            <if test="planGivenTime != null">#{planGivenTime},</if>
            <if test="planFinashDays != null">#{planFinashDays},</if>
            <if test="planFinashDays2 != null">#{planFinashDays2},</if>
            <if test="remark != null">#{remark},</if>
            <if test="creator != null">#{creator},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createId != null">#{createId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateId != null">#{updateId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderStatus != null">#{orderStatus},</if>
         </trim>
    </insert>

    <update id="updatePjProjectPlan" parameterType="PjProjectPlan">
        update pj_project_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="refProjectCode != null">ref_project_code = #{refProjectCode},</if>
            <if test="refProjectName != null and refProjectName != ''">ref_project_name = #{refProjectName},</if>
            <if test="planName != null and planName != ''">plan_name = #{planName},</if>
            <if test="planDetail != null and planDetail != ''">plan_detail = #{planDetail},</if>
            <if test="planTimeStart != null">plan_time_start = #{planTimeStart},</if>
            <if test="planTimeEnd != null">plan_time_end = #{planTimeEnd},</if>
            <if test="planDates != null and planDates != ''">plan_dates = #{planDates},</if>
            <if test="planGivenTime != null">plan_given_time = #{planGivenTime},</if>
            <if test="planFinashDays != null">plan_finash_days = #{planFinashDays},</if>
            <if test="planFinashDays2 != null">plan_finash_days2 = #{planFinashDays2},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="creator != null">creator = #{creator},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createId != null">create_id = #{createId},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateId != null">update_id = #{updateId},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderStatus != null">order_status = #{orderStatus},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePjProjectPlanById" parameterType="String">
        delete from pj_project_plan where id = #{id}
    </delete>

    <delete id="deletePjProjectPlanByIds" parameterType="String">
        delete from pj_project_plan where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>