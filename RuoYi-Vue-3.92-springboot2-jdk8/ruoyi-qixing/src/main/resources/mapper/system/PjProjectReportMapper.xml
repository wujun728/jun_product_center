<mapper namespace="com.ruoyi.qixing.mapper.PjProjectReportMapper">
    
    <resultMap type="PjProjectReport" id="PjProjectReportResult">
        <result property="id"    column="id"    />
        <result property="reportName"    column="report_name"    />
        <result property="refProjectCode"    column="ref_project_code"    />
        <result property="refProjectName"    column="ref_project_name"    />
        <result property="dictReportType"    column="dict_report_type"    />
        <result property="reportDetail"    column="report_detail"    />
        <result property="customerReq"    column="customer_req"    />
        <result property="reportTime"    column="report_time"    />
        <result property="refReportBy"    column="ref_report_by"    />
        <result property="reportFinashDays"    column="report_finash_days"    />
        <result property="dictReportStatus"    column="dict_report_status"    />
