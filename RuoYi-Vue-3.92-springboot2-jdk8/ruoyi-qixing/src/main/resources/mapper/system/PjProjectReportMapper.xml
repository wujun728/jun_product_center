    <sql id="selectPjProjectReportVo">
        select id, report_name, ref_project_code, ref_project_name, dict_report_type, report_detail, customer_req, report_time, ref_report_by, report_finash_days, dict_report_status, creator, reportnum_code, remark, create_time, create_id, update_time, update_id, order_id, order_status from pj_project_report
    </sql>

    <select id="selectPjProjectReportList" parameterType="PjProjectReport" resultMap="PjProjectReportResult">
        <include refid="selectPjProjectReportVo"/>
        <where>  
            <if test="reportName != null  and reportName != ''"> and report_name like concat('%', #{reportName}, '%')</if>
            <if test="refProjectCode != null  and refProjectCode != ''"> and ref_project_code = #{refProjectCode}</if>
            <if test="refProjectName != null  and refProjectName != ''"> and ref_project_name like concat('%', #{refProjectName}, '%')</if>
            <if test="dictReportType != null  and dictReportType != ''"> and dict_report_type = #{dictReportType}</if>
            <if test="reportDetail != null  and reportDetail != ''"> and report_detail = #{reportDetail}</if>
            <if test="customerReq != null  and customerReq != ''"> and customer_req = #{customerReq}</if>
            <if test="reportTime != null "> and report_time = #{reportTime}</if>
            <if test="refReportBy != null  and refReportBy != ''"> and ref_report_by = #{refReportBy}</if>
            <if test="reportFinashDays != null "> and report_finash_days = #{reportFinashDays}</if>
            <if test="dictReportStatus != null  and dictReportStatus != ''"> and dict_report_status = #{dictReportStatus}</if>
            <if test="creator != null  and creator != ''"> and creator = #{creator}</if>
            <if test="reportnumCode != null  and reportnumCode != ''"> and reportnum_code = #{reportnumCode}</if>
            <if test="createId != null  and createId != ''"> and create_id = #{createId}</if>
            <if test="updateId != null  and updateId != ''"> and update_id = #{updateId}</if>
            <if test="orderId != null  and orderId != ''"> and order_id = #{orderId}</if>
            <if test="orderStatus != null "> and order_status = #{orderStatus}</if>
        </where>
    </select>
    
    <select id="selectPjProjectReportById" parameterType="String" resultMap="PjProjectReportResult">
        <include refid="selectPjProjectReportVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertPjProjectReport" parameterType="PjProjectReport">
        insert into pj_project_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="reportName != null and reportName != ''">report_name,</if>
            <if test="refProjectCode != null">ref_project_code,</if>
            <if test="refProjectName != null and refProjectName != ''">ref_project_name,</if>
            <if test="dictReportType != null and dictReportType != ''">dict_report_type,</if>
            <if test="reportDetail != null">report_detail,</if>
            <if test="customerReq != null">customer_req,</if>
            <if test="reportTime != null">report_time,</if>
            <if test="refReportBy != null">ref_report_by,</if>
            <if test="reportFinashDays != null">report_finash_days,</if>
            <if test="dictReportStatus != null">dict_report_status,</if>
            <if test="creator != null">creator,</if>
            <if test="reportnumCode != null">reportnum_code,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
