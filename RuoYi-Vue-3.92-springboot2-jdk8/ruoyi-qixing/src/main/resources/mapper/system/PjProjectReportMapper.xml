            <if test="updateTime != null">update_time,</if>
            <if test="updateId != null">update_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderStatus != null">order_status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="reportName != null and reportName != ''">#{reportName},</if>
            <if test="refProjectCode != null">#{refProjectCode},</if>
            <if test="refProjectName != null and refProjectName != ''">#{refProjectName},</if>
            <if test="dictReportType != null and dictReportType != ''">#{dictReportType},</if>
            <if test="reportDetail != null">#{reportDetail},</if>
            <if test="customerReq != null">#{customerReq},</if>
            <if test="reportTime != null">#{reportTime},</if>
            <if test="refReportBy != null">#{refReportBy},</if>
            <if test="reportFinashDays != null">#{reportFinashDays},</if>
            <if test="dictReportStatus != null">#{dictReportStatus},</if>
            <if test="creator != null">#{creator},</if>
            <if test="reportnumCode != null">#{reportnumCode},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createId != null">#{createId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateId != null">#{updateId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderStatus != null">#{orderStatus},</if>
         </trim>
    </insert>

    <update id="updatePjProjectReport" parameterType="PjProjectReport">
        update pj_project_report
