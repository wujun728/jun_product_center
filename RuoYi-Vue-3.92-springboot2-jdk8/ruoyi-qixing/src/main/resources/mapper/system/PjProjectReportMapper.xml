            <if test="reportName != null and reportName != ''">report_name = #{reportName},</if>
            <if test="refProjectCode != null">ref_project_code = #{refProjectCode},</if>
            <if test="refProjectName != null and refProjectName != ''">ref_project_name = #{refProjectName},</if>
            <if test="dictReportType != null and dictReportType != ''">dict_report_type = #{dictReportType},</if>
            <if test="reportDetail != null">report_detail = #{reportDetail},</if>
            <if test="customerReq != null">customer_req = #{customerReq},</if>
