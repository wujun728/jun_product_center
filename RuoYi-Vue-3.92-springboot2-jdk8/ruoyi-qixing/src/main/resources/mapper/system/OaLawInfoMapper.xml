<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.qixing.mapper.OaLawInfoMapper">
    
    <resultMap type="OaLawInfo" id="OaLawInfoResult">
        <result property="id"    column="id"    />
        <result property="title"    column="title"    />
        <result property="content"    column="content"    />
        <result property="pid"    column="pid"    />
        <result property="pname"    column="pname"    />
        <result property="sortid"    column="sortid"    />
        <result property="dictMsgType"    column="dict_msg_type"    />
        <result property="dictIsDraft"    column="dict_is_draft"    />
        <result property="creator"    column="creator"    />
        <result property="refSendDept"    column="ref_send_dept"    />
        <result property="publishDate"    column="publish_date"    />
        <result property="invalidDate"    column="invalid_date"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="createId"    column="create_id"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateId"    column="update_id"    />
        <result property="deleted"    column="deleted"    />
    </resultMap>

    <sql id="selectOaLawInfoVo">
        select id, title, content, pid, pname, sortid, dict_msg_type, dict_is_draft, creator, ref_send_dept, publish_date, invalid_date, remark, create_time, create_id, update_time, update_id, deleted from oa_law_info
    </sql>

    <select id="selectOaLawInfoList" parameterType="OaLawInfo" resultMap="OaLawInfoResult">
        <include refid="selectOaLawInfoVo"/>
        <where>  
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="pid != null  and pid != ''"> and pid = #{pid}</if>
            <if test="pname != null  and pname != ''"> and pname like concat('%', #{pname}, '%')</if>
            <if test="sortid != null "> and sortid = #{sortid}</if>
            <if test="dictMsgType != null  and dictMsgType != ''"> and dict_msg_type = #{dictMsgType}</if>
            <if test="dictIsDraft != null  and dictIsDraft != ''"> and dict_is_draft = #{dictIsDraft}</if>
            <if test="creator != null  and creator != ''"> and creator = #{creator}</if>
            <if test="refSendDept != null  and refSendDept != ''"> and ref_send_dept = #{refSendDept}</if>
            <if test="publishDate != null "> and publish_date = #{publishDate}</if>
            <if test="invalidDate != null "> and invalid_date = #{invalidDate}</if>
            <if test="createId != null  and createId != ''"> and create_id = #{createId}</if>
            <if test="updateId != null  and updateId != ''"> and update_id = #{updateId}</if>
            <if test="deleted != null "> and deleted = #{deleted}</if>
        </where>
    </select>
    
    <select id="selectOaLawInfoById" parameterType="String" resultMap="OaLawInfoResult">
        <include refid="selectOaLawInfoVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertOaLawInfo" parameterType="OaLawInfo">
        insert into oa_law_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="pid != null">pid,</if>
            <if test="pname != null">pname,</if>
            <if test="sortid != null">sortid,</if>
            <if test="dictMsgType != null">dict_msg_type,</if>
            <if test="dictIsDraft != null">dict_is_draft,</if>
            <if test="creator != null">creator,</if>
            <if test="refSendDept != null">ref_send_dept,</if>
            <if test="publishDate != null">publish_date,</if>
            <if test="invalidDate != null">invalid_date,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createId != null">create_id,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateId != null">update_id,</if>
            <if test="deleted != null">deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="pid != null">#{pid},</if>
            <if test="pname != null">#{pname},</if>
            <if test="sortid != null">#{sortid},</if>
            <if test="dictMsgType != null">#{dictMsgType},</if>
            <if test="dictIsDraft != null">#{dictIsDraft},</if>
            <if test="creator != null">#{creator},</if>
            <if test="refSendDept != null">#{refSendDept},</if>
            <if test="publishDate != null">#{publishDate},</if>
            <if test="invalidDate != null">#{invalidDate},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createId != null">#{createId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateId != null">#{updateId},</if>
            <if test="deleted != null">#{deleted},</if>
         </trim>
    </insert>

    <update id="updateOaLawInfo" parameterType="OaLawInfo">
        update oa_law_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="pid != null">pid = #{pid},</if>
            <if test="pname != null">pname = #{pname},</if>
            <if test="sortid != null">sortid = #{sortid},</if>
            <if test="dictMsgType != null">dict_msg_type = #{dictMsgType},</if>
            <if test="dictIsDraft != null">dict_is_draft = #{dictIsDraft},</if>
            <if test="creator != null">creator = #{creator},</if>
            <if test="refSendDept != null">ref_send_dept = #{refSendDept},</if>
            <if test="publishDate != null">publish_date = #{publishDate},</if>
            <if test="invalidDate != null">invalid_date = #{invalidDate},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createId != null">create_id = #{createId},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateId != null">update_id = #{updateId},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOaLawInfoById" parameterType="String">
        delete from oa_law_info where id = #{id}
    </delete>

    <delete id="deleteOaLawInfoByIds" parameterType="String">
        delete from oa_law_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>