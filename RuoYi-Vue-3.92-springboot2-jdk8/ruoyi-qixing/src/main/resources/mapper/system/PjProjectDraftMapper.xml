    <delete id="deletePjProjectDraftById" parameterType="String">
        delete from pj_project_draft where id = #{id}
    </delete>

    <delete id="deletePjProjectDraftByIds" parameterType="String">
        delete from pj_project_draft where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
