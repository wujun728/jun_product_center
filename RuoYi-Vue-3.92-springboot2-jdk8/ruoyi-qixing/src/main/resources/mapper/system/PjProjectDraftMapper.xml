    <sql id="selectPjProjectDraftVo">
        select id, draft_name, dict_draft_type, ref_project_code, ref_project_name, draft_desc, draft_time, ref_draft_by, dict_draft_status, remark, creator, create_time, create_id, update_time, update_id, order_id, order_status from pj_project_draft
    </sql>

    <select id="selectPjProjectDraftList" parameterType="PjProjectDraft" resultMap="PjProjectDraftResult">
        <include refid="selectPjProjectDraftVo"/>
        <where>  
            <if test="draftName != null  and draftName != ''"> and draft_name like concat('%', #{draftName}, '%')</if>
            <if test="dictDraftType != null  and dictDraftType != ''"> and dict_draft_type = #{dictDraftType}</if>
            <if test="refProjectCode != null  and refProjectCode != ''"> and ref_project_code = #{refProjectCode}</if>
            <if test="refProjectName != null  and refProjectName != ''"> and ref_project_name like concat('%', #{refProjectName}, '%')</if>
            <if test="draftDesc != null  and draftDesc != ''"> and draft_desc = #{draftDesc}</if>
            <if test="draftTime != null "> and draft_time = #{draftTime}</if>
            <if test="refDraftBy != null  and refDraftBy != ''"> and ref_draft_by = #{refDraftBy}</if>
            <if test="dictDraftStatus != null  and dictDraftStatus != ''"> and dict_draft_status = #{dictDraftStatus}</if>
            <if test="creator != null  and creator != ''"> and creator = #{creator}</if>
            <if test="createId != null  and createId != ''"> and create_id = #{createId}</if>
            <if test="updateId != null  and updateId != ''"> and update_id = #{updateId}</if>
            <if test="orderId != null  and orderId != ''"> and order_id = #{orderId}</if>
            <if test="orderStatus != null "> and order_status = #{orderStatus}</if>
        </where>
    </select>
    
    <select id="selectPjProjectDraftById" parameterType="String" resultMap="PjProjectDraftResult">
        <include refid="selectPjProjectDraftVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertPjProjectDraft" parameterType="PjProjectDraft">
        insert into pj_project_draft
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
