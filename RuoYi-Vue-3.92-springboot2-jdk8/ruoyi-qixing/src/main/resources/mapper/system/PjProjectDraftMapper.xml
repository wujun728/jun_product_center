            <if test="dictDraftType != null and dictDraftType != ''">dict_draft_type,</if>
            <if test="refProjectCode != null">ref_project_code,</if>
            <if test="refProjectName != null and refProjectName != ''">ref_project_name,</if>
            <if test="draftDesc != null">draft_desc,</if>
            <if test="draftTime != null">draft_time,</if>
            <if test="refDraftBy != null">ref_draft_by,</if>
            <if test="dictDraftStatus != null">dict_draft_status,</if>
            <if test="remark != null">remark,</if>
            <if test="creator != null">creator,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createId != null">create_id,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateId != null">update_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderStatus != null">order_status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
