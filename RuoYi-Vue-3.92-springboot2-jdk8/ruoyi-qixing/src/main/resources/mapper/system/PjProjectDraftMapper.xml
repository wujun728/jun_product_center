<mapper namespace="com.ruoyi.qixing.mapper.PjProjectDraftMapper">
    
    <resultMap type="PjProjectDraft" id="PjProjectDraftResult">
        <result property="id"    column="id"    />
        <result property="draftName"    column="draft_name"    />
        <result property="dictDraftType"    column="dict_draft_type"    />
        <result property="refProjectCode"    column="ref_project_code"    />
