            <if test="updateId != null">#{updateId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderStatus != null">#{orderStatus},</if>
         </trim>
    </insert>

    <update id="updatePjProjectDraft" parameterType="PjProjectDraft">
        update pj_project_draft
        <trim prefix="SET" suffixOverrides=",">
            <if test="draftName != null and draftName != ''">draft_name = #{draftName},</if>
            <if test="dictDraftType != null and dictDraftType != ''">dict_draft_type = #{dictDraftType},</if>
            <if test="refProjectCode != null">ref_project_code = #{refProjectCode},</if>
